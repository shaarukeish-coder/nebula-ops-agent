# Get this from @BotFather on Telegram (free) - send /newbot and follow prompts
TELEGRAM_BOT_TOKEN=

# Get this free at https://aistudio.google.com/app/apikey (no card needed)
GOOGLE_GENERATIVE_AI_API_KEY=

# Where the SQLite database file lives (created automatically on first run)
DB_PATH=./data/store.db

# Optional defaults - the owner can also set/change these later via chat
# ("set shop name to X", "our GSTIN is Y") and they'll persist the same way.
SHOP_NAME=Nebula Kirana Store
SHOP_GSTIN=
